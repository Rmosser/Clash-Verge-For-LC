[Unit]
Description=Mihomo container proxy service (172.18.0.1:17890 -> 127.0.0.1:7890)
Requires=mihomo.service
After=mihomo.service
Requires=mihomo-container-proxy.socket
After=mihomo-container-proxy.socket

[Service]
Type=notify
# Each proxied connection holds two sockets and two pipes (~6 fds); the default soft limit of 1024 ran out
# at ~170 connections when 16 agy calls started at once (2026-10-26, "Failed to allocate pipe buffer").
ExecStart=/lib/systemd/systemd-socket-proxyd --connections-max=1024 127.0.0.1:7890
LimitNOFILE=65536
User=nobody
Group=nogroup
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
