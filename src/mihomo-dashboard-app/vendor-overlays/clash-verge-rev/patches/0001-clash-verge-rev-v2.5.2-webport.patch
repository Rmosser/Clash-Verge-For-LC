+
+    expect(getWebActionPolicy("systemProxy")).toEqual({
+      mode: "disabled",
+      reason:
+        "LazyCat 微服 Web 版不支持接管宿主机系统代理，请使用虚拟网卡模式（TUN）或显式代理入口。",
