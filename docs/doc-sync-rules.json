    ".github/pull_request_template.md",
    "scripts/check_docs.py",
    "scripts/check_loop_checkpoints.py",
    ".github/workflows/codex-review-gate.yml",
    "scripts/check_codex_review.py",
    ".github/workflows/codex-review-heartbeat.yml"
  ],
  "entrypoint_links": [
    {
      "source": "AGENTS.md",
      "targets": [
        "docs/index.md",
        "docs/governance/checkpoint-ci-gate.md",
        "docs/exec-plans/template.md",
        "docs/doc-sync-rules.json",
        ".harness/repo-contract.json"
      ]
    },
    {
      "source": "docs/index.md",
      "targets": [
        "AGENTS.md",
        "docs/governance/checkpoint-ci-gate.md",
        "docs/exec-plans/template.md",
        "docs/doc-sync-rules.json",
        ".harness/repo-contract.json"
      ]
    },
    {
      "source": "README.md",
      "targets": [
        "docs/index.md"
      ]
    },
    {
      "source": "docs/README.md",
      "targets": [
        "docs/index.md"
      ]
    }
  ],
  "link_check_exclude_globs": [
    "docs/planning/2026-03-12-clash-post-deploy-network-incident.md"
