{
  "contract_version": "agent-cicd-checkpoint-gate-v0",
  "repo": "Rmosser/Clash-Verge-For-LC",
  "mode": "repo-native-agent-cicd",
  "primary_governance_language": "zh-CN",
  "boundary": {
    "controls": [
      "merge_eligibility",
      "evidence_completeness",
      "claim_fact_consistency"
    ],
    "does_not_control": [
      "agent_write_access_to_worktree",
      "agent_push_access_to_pr_branch",
      "agent_cloud_connector_access"
    ]
  },
  "checkpoint_gate": {
    "governance_doc": "docs/governance/checkpoint-ci-gate.md",
    "planned_required_check": "ci/woodpecker/pr/woodpecker-harness",
    "claims": [
      "context_claim",
      "scope_claim",
      "change_claim",
      "validation_claim"
    ],
    "reconciliation": {
      "context_claim": "diff_class_and_doc_rules",
      "scope_claim": "policy_active_plan_and_forbidden_paths",
      "change_claim": "git_diff",
      "validation_claim": "validation_registry_and_ci_result"
    }
  },
  "development_ci": {
    "state": "candidate_canary_pending",
    "woodpecker_repo_id": null,
    "activated": false,
    "workflow_installed": true,
    "workflow_installed_on_default_branch": false,
    "workflow_path": ".woodpecker/woodpecker-harness.yaml",
    "agent_selector": {
      "backend": "docker",
      "hostname": "rainierdev-docker-01"
    },
    "events": [
      "pull_request:main",
      "push:main"
    ],
    "secret_access": false,
    "privileged": false,
    "volumes": false,
    "docker_socket": false,
    "publish_or_deploy": false,
    "runtime_mutation": false,
    "test_data_policy": "source_tree_only_no_host_runtime_or_real_credentials",
    "live_context": null,
    "canary_evidence": {
      "initial_success": null,
      "intentional_failure": null,
      "repair_success": null
    },
    "checks": [
      "committed_pr_or_push_diff_check",
      "tracked_shell_bash_syntax",
      "governance_json_parse",
      "frozen_pnpm_install",
      "typescript_typecheck",
      "vitest_unit",
      "eslint_zero_warning",
      "vite_production_build"
    ]
  },
  "codex_review": {
    "required_for_non_trivial_pr": true,
    "latest": null,
    "review_supervision_model": "trusted_agent_interpreted"
  },
  "platform_gate": {
    "status": "live_context_pending",
    "platform_gate_ready": false,
    "live_context_discovered": false,
    "required_context_installed": false,
    "requires": [
      "github_required_checks",
      "branch_protection_or_ruleset",
      "failing_pr_or_platform_read_evidence"
    ]
  }
}
