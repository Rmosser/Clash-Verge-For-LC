{
  "contract_version": "repo-harness-v3",
  "repository": "Rmosser/Clash-Verge-For-LC",
  "repository_id": null,
  "default_branch": "main",
  "verifier": {
    "release": "repo-harness-verifier-v3.1",
    "sha256": "d2ae78a38263db8e111bd17fe8cb18e4715c9b325837c792bf4dd2d6b63e5e43",
    "authority": "source_isolated_publisher_bundle"
  },
  "task_record_policy": {
    "task_class_values": [
      "trivial",
      "standard",
      "critical"
    ],
    "record_actual": [
      "model",
      "reasoning_effort",
      "speed"
    ],
    "model_policy": "record_selector_value_verbatim",
    "reasoning_effort_values": [
      "light",
      "medium",
      "high",
      "extra_high",
      "ultra"
    ],
    "speed_values": [
      "standard",
      "fast"
    ],
    "unknown_allowed": true
  },
  "control_plane_paths": [
    {
      "kind": "exact",
      "pattern": ".harness/repo-contract.json"
    },
    {
      "kind": "exact",
      "pattern": "AGENTS.md"
    },
    {
      "kind": "exact",
      "pattern": ".github/pull_request_template.md"
    },
    {
      "kind": "glob",
      "pattern": ".github/workflows/**"
    },
    {
      "kind": "exact",
      "pattern": "scripts/check_harness.py"
    },
    {
      "kind": "exact",
      "pattern": "docs/index.md"
    },
    {
      "kind": "exact",
      "pattern": "docs/doc-sync-rules.json"
    },
    {
      "kind": "glob",
      "pattern": "docs/governance/**"
    },
    {
      "kind": "exact",
      "pattern": "docs/exec-plans/template.md"
    },
    {
      "kind": "glob",
      "pattern": "evals/harness/**"
    }
  ],
  "audit_state_paths": [
    {
      "kind": "exact",
      "pattern": ".harness/baseline-receipt.json"
    }
  ],
  "required_files": [
    "AGENTS.md",
    ".harness/repo-contract.json",
    ".github/pull_request_template.md",
    ".github/workflows/product-validation.yml",
    "scripts/check_harness.py",
    "docs/index.md",
    "docs/doc-sync-rules.json",
    "docs/governance/harness.md",
    "docs/exec-plans/template.md"
  ],
  "required_checks": [
    {
      "context": "harness/evidence",
      "kind": "machine",
      "publisher": {
        "model": "source_isolated_github_app",
        "app_id": null,
        "app_slug": null
      }
    },
    {
      "context": "product/validation",
      "kind": "machine",
      "publisher": {
        "model": "github_actions_shared",
        "app_id": null,
        "app_slug": "github-actions"
      }
    }
  ],
  "platform_gate": {
    "state": "pending",
    "pending_reason": "actions_outage_and_publisher_not_installed"
  },
  "publisher_validation": {
    "model": "external_sandbox_profile",
    "profile_id": null,
    "profile_sha256": null
  },
  "revalidation_groups": {
    "entrypoint": {
      "paths": [
        "AGENTS.md",
        "docs/index.md",
        "docs/doc-sync-rules.json",
        "docs/exec-plans/template.md"
      ],
      "commands": [
        "python3 -I -B scripts/check_harness.py --repo .",
        "python3 -m json.tool docs/doc-sync-rules.json >/dev/null"
      ]
    },
    "evidence": {
      "paths": [
        ".harness/repo-contract.json",
        ".github/workflows/**",
        "scripts/check_harness.py",
        "evals/harness/**"
      ],
      "commands": [
        "python3 -I -B scripts/check_harness.py --repo .",
        "bash scripts/test.sh"
      ]
    },
    "review_protocol": {
      "paths": [
        ".github/pull_request_template.md",
        "docs/governance/harness.md"
      ],
      "commands": [
        "python3 -I -B scripts/check_harness.py --repo ."
      ]
    },
    "platform": {
      "paths": [
        ".harness/repo-contract.json",
        ".github/workflows/**",
        "docs/governance/harness.md"
      ],
      "commands": [
        "python3 -I -B scripts/check_harness.py --repo . --check-platform"
      ]
    }
  },
  "review": {
    "supervision_model": "trusted_agent_interpreted",
    "allowed_authors": [
      "chatgpt-codex-connector[bot]"
    ],
    "head_requirement": "exact_live_pr_head",
    "clean_requirement": "complete_explicit_no_findings",
    "finding_policy": "any_finding_blocks",
    "fail_closed_on": [
      "missing",
      "partial",
      "timeout",
      "stale_head",
      "ambiguous_author"
    ],
    "required_status_translation": false
  },
  "github_policy": {
    "pr_only": true,
    "strict_base_freshness": true,
    "no_bypass": true,
    "same_repository_prs_only": true,
    "force_push_allowed": false,
    "branch_deletion_allowed": false,
    "expected_head_required": true,
    "merge_authority_model": "owner_or_explicitly_authorized_agent_initiates_without_bypass"
  },
  "baseline_receipt": {
    "path": ".harness/baseline-receipt.json",
    "schema_version": "repo-harness-baseline-receipt-v1",
    "evidence_kind": "github_app_check_run",
    "check_name": "harness/baseline",
    "allowed_validators": [
      "Rmosser"
    ]
  }
}
